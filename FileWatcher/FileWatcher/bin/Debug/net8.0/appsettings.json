{
    "MonitorSettings": {
        "Enabled": true,
        "MonitorPath": "C:\\MonitoredFolder",
        "LogPath": "C:\\WatcherLogs",
        "BatchSize": 100,
        "BatchTimeoutMs": 1000,
        "AutoRestartOnError": true
    },
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft": "Warning"
        },
        "File": {
            "Path": "C:\\Logs\\service-log.txt",
            "FileSizeLimitBytes": 10485760,
            "MaxRollingFiles": 3
        }
    },
    "Kafka": {
        "BootstrapServers": "localhost:9092",
        "Topic": "file-activities"
    }
}